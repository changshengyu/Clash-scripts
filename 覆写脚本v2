const main = (config) => {

  // =========================================
  // 初始化
  // =========================================

  config.proxies = config.proxies || [];
  config["proxy-groups"] = config["proxy-groups"] || [];
  config.rules = config.rules || [];

  const allProxies = config.proxies;

  const allProxyNames = allProxies
    .map(p => p && p.name)
    .filter(Boolean);

  // =========================================
  // 节点过滤函数
  // =========================================

  const filterProxies = (regex) => {
    return allProxyNames.filter(name => regex.test(name));
  };

  // =========================================
  // 地区节点筛选（修复误匹配）
  // =========================================

  const hkNodes = filterProxies(
    /香港|HK|HKG|Hong\s?Kong|🇭🇰/i
  );

  const twNodes = filterProxies(
    /台湾|TW|TWN|Taiwan|🇹🇼/i
  );

  const jpNodes = filterProxies(
    /日本|JP|JPN|Japan|东京|大阪|埼玉|🇯🇵/i
  );

  const krNodes = filterProxies(
    /韩国|KR|KOR|Korea|首尔|🇰🇷/i
  );

  const sgNodes = filterProxies(
    /新加坡|SG|SGP|Singapore|狮城|🇸🇬/i
  );

  const usNodes = filterProxies(
    /美国|US|USA|United\s?States|洛杉矶|硅谷|西雅图|🇺🇸/i
  );

  // =========================================
  // 删除旧组（避免重复）
  // =========================================

  const customGroups = [
    "🚀 节点选择",
    "亚洲自动策略",
    "全球自动策略",

    "🌍 Google",
    "📲 Telegram",
    "🍎 Apple",
    "🎬流媒体",

    "香港自动策略",
    "台湾自动策略",
    "日本自动策略",
    "韩国自动策略",
    "新国自动策略",
    "美国自动策略"
  ];

  config["proxy-groups"] =
    config["proxy-groups"].filter(
      group => !customGroups.includes(group.name)
    );

  // =========================================
  // 创建 URL-Test 自动组
  // =========================================

  const createUrlTestGroup = (name, proxies) => {

    // 防止空组报错
    if (!proxies || proxies.length === 0) {
      proxies = ["DIRECT"];
    }

    return {
      name,
      type: "url-test",
      proxies,
      url: "https://cp.cloudflare.com/generate_204",
      interval: 300,
      tolerance: 200
    };
  };

  // =========================================
  // 构建代理组
  // =========================================

  const proxyGroups = [

    // =====================================
    // 主选择器（最前面）
    // =====================================

    {
      name: "🚀 节点选择",
      type: "select",
      proxies: [
        "亚洲自动策略",
        "全球自动策略",

        "日本自动策略",
        "新国自动策略",
        "台湾自动策略",
        "香港自动策略",

        "美国自动策略",
        "韩国自动策略",

        "DIRECT",

        ...allProxyNames
      ]
    },

    // =====================================
    // 亚洲自动策略
    // JP -> SG -> TW -> HK
    // =====================================

    {
      name: "亚洲自动策略",
      type: "fallback",
      proxies: [
        "日本自动策略",
        "新国自动策略",
        "台湾自动策略",
        "香港自动策略"
      ],
      url: "https://cp.cloudflare.com/generate_204",
      interval: 300
    },

    // =====================================
    // 全球自动策略
    // US -> JP -> SG -> TW -> HK
    // =====================================

    {
      name: "全球自动策略",
      type: "fallback",
      proxies: [
        "美国自动策略",
        "日本自动策略",
        "新国自动策略",
        "台湾自动策略",
        "香港自动策略"
      ],
      url: "https://cp.cloudflare.com/generate_204",
      interval: 300
    },

    // =====================================
    // 业务组
    // =====================================

    {
      name: "🌍 Google",
      type: "select",
      proxies: [
        "亚洲自动策略",
        "全球自动策略",
        "日本自动策略",
        "新国自动策略",
        "DIRECT"
      ]
    },

    {
      name: "📲 Telegram",
      type: "select",
      proxies: [
        "亚洲自动策略",
        "全球自动策略",
        "日本自动策略",
        "新国自动策略",
        "DIRECT"
      ]
    },

    {
      name: "🍎 Apple",
      type: "select",
      proxies: [
        "DIRECT",
        "亚洲自动策略",
        "香港自动策略",
        "台湾自动策略"
      ]
    },

    {
      name: "🎬流媒体",
      type: "select",
      proxies: [
        "亚洲自动策略",
        "日本自动策略",
        "新国自动策略",
        "美国自动策略"
      ]
    },

    // =====================================
    // 地区自动测速组
    // =====================================

    createUrlTestGroup(
      "日本自动策略",
      jpNodes
    ),

    createUrlTestGroup(
      "新国自动策略",
      sgNodes
    ),

    createUrlTestGroup(
      "台湾自动策略",
      twNodes
    ),

    createUrlTestGroup(
      "香港自动策略",
      hkNodes
    ),

    createUrlTestGroup(
      "美国自动策略",
      usNodes
    ),

    createUrlTestGroup(
      "韩国自动策略",
      krNodes
    )

  ];

  // =========================================
  // 插入代理组
  // =========================================

  config["proxy-groups"].unshift(...proxyGroups);

  // =========================================
  // 基础规则（后面你再补）
  // =========================================

  config.rules = [

    // Clash 面板
    "DOMAIN,clash.razord.top,DIRECT",
    "DOMAIN,yacd.haishan.me,DIRECT",

    // 最终兜底
    "MATCH,🚀 节点选择"
  ];

  return config;
};
