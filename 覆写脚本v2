proxy-groups:

# -------------------------
# 地区手动策略
# -------------------------

  - name: 香港手动策略
    type: select
    proxies:
      - 香港节点
      - DIRECT

  - name: 台湾手动策略
    type: select
    proxies:
      - 台湾节点
      - DIRECT

  - name: 日本手动策略
    type: select
    proxies:
      - 日本节点
      - DIRECT

  - name: 韩国手动策略
    type: select
    proxies:
      - 韩国节点
      - DIRECT

  - name: 新国手动策略
    type: select
    proxies:
      - 新国节点
      - DIRECT

  - name: 美国手动策略
    type: select
    proxies:
      - 美国节点
      - DIRECT

  - name: 游戏手动策略
    type: select
    proxies:
      - 游戏节点
      - DIRECT

  - name: 全球手动策略
    type: select
    proxies:
      - 全球节点
      - DIRECT

# -------------------------
# 地区自动测速策略
# -------------------------

  - name: 香港自动策略
    type: url-test
    proxies:
      - 香港节点
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 200

  - name: 台湾自动策略
    type: url-test
    proxies:
      - 台湾节点
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 200

  - name: 日本自动策略
    type: url-test
    proxies:
      - 日本节点
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 200

  - name: 韩国自动策略
    type: url-test
    proxies:
      - 韩国节点
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 200

  - name: 新国自动策略
    type: url-test
    proxies:
      - 新国节点
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 200

  - name: 美国自动策略
    type: url-test
    proxies:
      - 美国节点
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 200

# -------------------------
# 亚洲自动策略（核心）
# JP -> SG -> TW -> HK
# -------------------------

  - name: 亚洲自动策略
    type: fallback
    proxies:
      - 日本自动策略
      - 新国自动策略
      - 台湾自动策略
      - 香港自动策略
    url: https://cp.cloudflare.com/generate_204
    interval: 300

# -------------------------
# 全球自动策略
# US -> JP -> SG -> TW -> HK
# -------------------------

  - name: 全球自动策略
    type: fallback
    proxies:
      - 美国自动策略
      - 日本自动策略
      - 新国自动策略
      - 台湾自动策略
      - 香港自动策略
    url: https://cp.cloudflare.com/generate_204
    interval: 300

# -------------------------
# 业务策略组
# -------------------------

  - name: 🌍 Google
    type: select
    proxies:
      - 亚洲自动策略
      - 全球自动策略
      - 日本自动策略
      - 新国自动策略
      - DIRECT

  - name: 📲 Telegram
    type: select
    proxies:
      - 亚洲自动策略
      - 全球自动策略
      - 日本自动策略
      - 新国自动策略
      - DIRECT

  - name: 🍎 Apple
    type: select
    proxies:
      - DIRECT
      - 亚洲自动策略
      - 香港自动策略
      - 台湾自动策略

  - name: 🎬流媒体
    type: select
    proxies:
      - 亚洲自动策略
      - 日本自动策略
      - 新国自动策略
      - 美国自动策略

# -------------------------
# 主代理组
# -------------------------

  - name: 🚀 节点选择
    type: select
    proxies:
      - 亚洲自动策略
      - 全球自动策略
      - 香港自动策略
      - 台湾自动策略
      - 日本自动策略
      - 新国自动策略
      - 美国自动策略
      - DIRECT
